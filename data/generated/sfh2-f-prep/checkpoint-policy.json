{
  "candidate_only": true,
  "canonical_write_back": false,
  "checkpoint_fields": [
    "unit_id",
    "request_hash",
    "status",
    "attempt",
    "contract_valid",
    "output_hash",
    "provider_witness_hash",
    "runtime_metadata"
  ],
  "different_request_hash_rule": "never silently reuse",
