        "source_normalized_filename": "KR3l0002_002.md"
      },
      "quote": "(令庾亮以元舅輔政欲以風軌格政繩御四/晉陽秋曰是時成帝在繦褓太后臨朝中書)",
      "source": "source-001",
      "source_layer": "liu_annotation"
    },
    "evidence-sc1-27-jiajue-008-annotation-002": {
      "evidence_ref": "evidence-sc1-27-jiajue-008-annotation-002",
      "locator": {
        "annotation_id": "annotation-002",
        "artifact_path": "content/processed/shishuo/entries/27-jiajue/entry-008.md",
        "artifact_type": "shishuo_entry",
        "chapter_id": "27-jiajue",
        "entry_id": "27-jiajue-008",
        "source_normalized_filename": "KR3l0002_002.md"
      },
      "quote": "(不欲亮曰蘇峻豺狼終為禍亂晁錯所謂削亦反不/海而峻擁兵近甸為逋逃藪亮圖召峻王導卞壷並)",
      "source": "source-001",
      "source_layer": "liu_annotation"
    },
    "evidence-sc1-27-jiajue-008-annotation-003": {
      "evidence_ref": "evidence-sc1-27-jiajue-008-annotation-003",
      "locator": {
        "annotation_id": "annotation-003",
        "artifact_path": "content/processed/shishuo/entries/27-jiajue/entry-008.md",
        "artifact_type": "shishuo_entry",
        "chapter_id": "27-jiajue",
        "entry_id": "27-jiajue-008",
        "source_normalized_filename": "KR3l0002_002.md"
      },
      "quote": "(殺我也遂克京邑平南温嶠聞亂號泣登舟遣叅軍/削亦反遂下優詔以大司農徵之峻怒曰庾亮欲誘)",
      "source": "source-001",
      "source_layer": "liu_annotation"
    },
    "evidence-sc1-27-jiajue-008-annotation-004": {
      "evidence_ref": "evidence-sc1-27-jiajue-008-annotation-004",
      "locator": {
        "annotation_id": "annotation-004",
        "artifact_path": "content/processed/shishuo/entries/27-jiajue/entry-008.md",
        "artifact_type": "shishuo_entry",
        "chapter_id": "27-jiajue",
        "entry_id": "27-jiajue-008",
        "source_normalized_filename": "KR3l0002_002.md"
      },
      "quote": "(奔嶠人皆尤而少之嶠愈相崇重分兵以配給之/王愆期推征西陶侃為盟主俱赴京師時亮敗績)",
      "source": "source-001",
      "source_layer": "liu_annotation"
    },
    "evidence-sc1-27-jiajue-008-main": {
      "evidence_ref": "evidence-sc1-27-jiajue-008-main",
      "locator": {
        "annotation_id": null,
        "artifact_path": "content/processed/shishuo/entries/27-jiajue/entry-008.md",
        "artifact_type": "shishuo_entry",
        "chapter_id": "27-jiajue",
        "entry_id": "27-jiajue-008",
        "source_normalized_filename": "KR3l0002_002.md"
      },
      "quote": "陶公自上流來赴蘇峻之難令誅庾公謂必戮庾可\n以謝峻\n\n\n庾\n欲奔竄則不可欲㑹恐見執進退無計温公勸庾詣\n陶曰卿但遥拜必無它我為卿保之庾從温言詣陶\n至便拜陶自起止之曰庾元規何縁拜陶士衡畢又\n降就下坐陶又自要起同坐坐定庾乃引咎責躬深\n相遜謝陶不覺釋然",
      "source": "source-001",
      "source_layer": "base_text"
    },
