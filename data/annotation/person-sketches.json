      "life_glimpse": [
        {
          "text": "《世說》在本則以「庾太尉」「元規」稱庾亮，並以他的風儀作爲孩子的參照。",
          "assertion_status": "attested",
          "review_status": "candidate",
          "evidence_ids": [
            "evidence-sc1-06-yaliang-017-main"
          ],
          "story_ids": [
            "06-yaliang-017"
          ]
        },
        {
          "text": "劉注所引《庾氏譜》稱，庾亮長子庾會十九歲時在咸和六年遇害。",
          "assertion_status": "reported",
          "review_status": "candidate",
          "evidence_ids": [
            "evidence-sc1-06-yaliang-017-annotation-001",
            "evidence-sc1-06-yaliang-017-annotation-002"
          ],
          "story_ids": [
            "06-yaliang-017"
          ]
        },
        {
          "text": "「不減亮」的評語與庾會後來的遭遇在本則結尾相接。",
          "assertion_status": "inferred",
          "review_status": "candidate",
          "evidence_ids": [
            "evidence-sc1-06-yaliang-017-main",
            "evidence-sc1-06-yaliang-017-annotation-001",
            "evidence-sc1-06-yaliang-017-annotation-002"
          ],
          "story_ids": [
            "06-yaliang-017"
          ]
        }
