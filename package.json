{
  "name": "shishuo-sketch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:sample": "python3 scripts/build_wp1_sample.py",
    "build:sc1": "python3 scripts/build_sc1_frontend_data.py",
    "build:story-scene-contexts": "python3 scripts/build_story_scene_contexts.py",
    "build:person-story": "python3 scripts/build_person_story_index.py",
    "build:story-chain-gold": "python3 scripts/build_story_chain_gold.py",
    "build:person-identity": "python3 scripts/build_person_identity_candidates.py",
    "build:person-expansion": "python3 scripts/build_person_expansion_candidates.py",
