    "build:m2-experience-metrics": "python3 scripts/m2_experience_metrics.py",
    "build:m2-production": "python3 scripts/materialize_person_expansion_wave.py && python3 scripts/build_wp1_sample.py && python3 scripts/build_sc1_frontend_data.py && python3 scripts/build_story_scene_contexts.py && python3 scripts/build_sc1_frontend_data.py && python3 scripts/build_person_relation_candidates_r3.py && python3 scripts/m2_experience_metrics.py",
    "build:person-expansion-wave-2": "python3 scripts/materialize_person_expansion_wave.py",
    "validate:person-ids": "python3 scripts/validate_person_ids.py",
    "validate:person-identity": "python3 scripts/validate_person_identity_candidates.py",
    "validate:person-sketch": "python3 scripts/validate_person_sketch.py --bundle",
    "validate:person-expansion": "python3 scripts/validate_person_expansion_candidates.py",
    "validate:person-relation-candidates-r3": "python3 scripts/validate_person_relation_candidates_r3.py",
    "validate:person-resolution": "python3 scripts/validate_person_resolution.py",
    "validate:person-expansion-wave-1": "python3 scripts/validate_person_expansion_wave.py",
    "validate:m2-person-expansion": "python3 scripts/validate_m2_person_expansion.py",
    "validate:m2-story-expansion": "python3 scripts/validate_m2_story_expansion.py",
    "build:reading-layer": "python3 scripts/build_shishuo_reading_layer.py",
    "validate:person-story": "python3 scripts/validate_person_story_index.py",
    "validate:story-chain-gold": "python3 scripts/validate_story_chain_gold.py",
    "validate:sc1": "python3 scripts/validate_sc1_frontend_data.py",
    "validate:story-scene-contexts": "python3 scripts/validate_story_scene_contexts.py",
    "validate:reading-layer": "python3 scripts/validate_shishuo_reading_layer.py",
    "validate": "python3 scripts/validate_wp1.py",
    "validate:frontend-artifact": "python3 scripts/validate_frontend_artifact.py --production",
    "typecheck": "tsc -p site/tsconfig.json --noEmit",
    "dev": "vite --config site/vite.config.ts",
    "build:site": "vite build --config site/vite.config.ts",
    "build": "npm run build:m2-production && npm run validate:person-ids && npm run validate:person-resolution && npm run validate && npm run validate:sc1 && npm run validate:m2-story-expansion && npm run validate:story-scene-contexts && npm run validate:person-relation-candidates-r3 && npm run validate:m2-person-expansion && npm run typecheck && vite build --config site/vite.config.ts && python3 scripts/m2_experience_metrics.py --production-artifact",
    "test": "python3 -m unittest discover -s tests -p 'test*.py'"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.3"
  }
