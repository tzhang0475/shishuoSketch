{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shishuo-sketch/schema/person-expansion-materialization-m2.schema.json",
  "title": "M2A Person expansion materialization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "stage", "wave_id", "source_ranking_artifact", "source_ranking_sha256", "people_before", "people_after", "promoted_mention_count", "withheld_occurrence_count", "production_evidence_ids", "members", "protected_hashes"],
  "properties": {
    "schema": {"const": 1},
    "stage": {"const": "m2a-person-expansion-wave-2-materialization"},
    "wave_id": {"const": "p3b-wave-2"},
    "source_ranking_artifact": {"const": "data/derived/m2-person-expansion-ranking.json"},
    "source_ranking_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "people_before": {"const": 17},
    "people_after": {"const": 35},
    "promoted_mention_count": {"type": "integer", "minimum": 0},
    "withheld_occurrence_count": {"type": "integer", "minimum": 0},
    "production_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "members": {"type": "array", "minItems": 18, "maxItems": 18, "items": {"type": "object"}},
    "protected_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
