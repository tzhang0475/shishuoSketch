{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "H0B-0 pilot selection",
  "type": "object",
  "required": [
    "schema",
    "stage",
    "selection_status",
    "selected_person_ids",
    "selection_rationale"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "stage": {
      "const": "h0b0-social-backbone-pilot-selection"
    },
    "selection_status": {
      "const": "frozen"
    },
    "selected_person_ids": {
      "type": "array",
      "minItems": 15,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^person-[0-9]{3}$"
      }
    },
    "selection_rationale": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "cluster",
          "person_ids",
          "reason"
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
