{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shishuo-sketch/schema/sc1-site.schema.json",
  "title": "SC1 static frontend bundle",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "generated_from", "stories", "people", "mentions", "relations", "eras", "evidence", "sources", "person_sketches", "story_chain", "ui"],
  "properties": {
    "schema": {"const": 1},
    "generated_from": {"const": "scripts/build_sc1_frontend_data.py"},
    "stories": {
      "type": "array",
      "minItems": 16,
      "items": {
        "type": "object",
        "required": ["id", "text", "reading", "annotations", "person_ids", "mention_ids", "publication_state"],
        "properties": {
          "id": {"type": "string"},
          "text": {"type": "string", "minLength": 1},
          "person_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "mention_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "publication_state": {"enum": ["production_ready", "preview_ready", "blocked"]},
          "reading": {
            "type": "object",
            "required": ["entry_id", "status", "main_text", "annotations", "mention_projection"],
            "properties": {
              "entry_id": {"type": "string"},
              "status": {"enum": ["reviewed", "aligned", "candidate", "disputed"]},
              "main_text": {
                "type": "object",
                "required": ["original", "simplified", "segments"],
                "properties": {
                  "original": {"type": "string"},
                  "simplified": {"type": "string"},
                  "segments": {"type": "array", "items": {"$ref": "#/$defs/readingSegment"}}
                }
              },
              "annotations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "original", "simplified", "segments", "display_source", "punctuation_status", "insertion"],
                  "properties": {
                    "id": {"type": "string"},
                    "original": {"type": "string"},
                    "simplified": {"type": "string"},
                    "segments": {"type": "array", "items": {"$ref": "#/$defs/readingSegment"}},
                    "display_source": {"enum": ["punctuation_record", "canonical_source"]},
                    "punctuation_status": {"enum": ["available", "unavailable"]},
                    "insertion": {
                      "type": "object",
                      "required": ["status", "main_text_offset", "source", "reason", "label"],
                      "properties": {
                        "status": {"enum": ["safe", "unavailable"]},
                        "main_text_offset": {"type": ["integer", "null"]},
                        "source": {"type": ["string", "null"]},
                        "reason": {"type": "string"},
                        "label": {"type": "string"}
                      }
                    },
                    "evidence_ids": {"type": "array", "items": {"type": "string"}}
                  }
                }
              },
              "mention_projection": {
                "type": "object",
                "required": ["suppressed"],
                "properties": {
                  "suppressed": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["reason", "section"],
                      "properties": {
                        "kind": {"enum": ["annotation_marker"]},
                        "mention_id": {"type": "string"},
                        "annotation_id": {"type": ["string", "null"]},
                        "reason": {"enum": ["unsafe_anchor", "overlapping_anchor", "display_conversion_context_mismatch", "unsafe_insertion_point", "insertion_inside_person_mention", "marker_projection_failed"]},
                        "section": {"enum": ["main_text", "liu_annotation"]}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "people": {"type": "array", "items": {"type": "object", "required": ["id"]}},
    "mentions": {"type": "array", "items": {"type": "object", "required": ["id", "story_id"]}},
    "relations": {"type": "array", "items": {"type": "object", "required": ["id"]}},
    "eras": {"type": "array", "items": {"type": "object", "required": ["id"]}},
    "evidence": {"type": "array", "items": {"type": "object", "required": ["id"]}},
    "sources": {"type": "array", "items": {"type": "object", "required": ["id"]}},
    "person_sketches": {
      "type": "object",
      "minProperties": 7,
      "additionalProperties": {"$ref": "#/$defs/personSketch"}
    },
    "story_chain": {
      "type": "object",
      "required": ["schema", "stage", "story_ids", "person_story_refs", "story_person_refs"],
      "properties": {
        "schema": {"const": 1},
        "stage": {"const": "sc1-story-chain-frontend"},
        "story_ids": {"type": "array", "minItems": 16, "uniqueItems": true, "items": {"type": "string"}},
        "person_story_refs": {"type": "array"},
        "story_person_refs": {"type": "array"}
      }
    },
    "ui": {"type": "object"}
  },
  "$defs": {
    "readingSegment": {
      "type": "object",
      "required": ["type", "display"],
      "properties": {
        "type": {"enum": ["text", "person_mention", "annotation_marker"]},
        "display": {
          "type": "object",
          "required": ["original", "simplified"],
          "properties": {"original": {"type": "string"}, "simplified": {"type": "string"}}
        },
        "mention_id": {"type": "string"},
        "person_id": {"type": "string"},
        "annotation_id": {"type": "string"},
        "label": {
          "type": "object",
          "required": ["original", "simplified"],
          "properties": {"original": {"type": "string"}, "simplified": {"type": "string"}}
        }
      }
    },
    "readingPair": {
      "type": "object",
      "required": ["original", "simplified"],
      "properties": {
        "original": {"type": "string"},
        "simplified": {"type": "string"}
      }
    },
    "personSketchAlias": {
      "type": "object",
      "required": ["alias_id", "surface", "alias_type", "label", "resolution_mode", "semantic_status", "semantic_label", "status", "observed_in_shishuo", "source_layers", "occurrence_count", "mention_ids", "evidence_ids", "display_order"],
      "properties": {
        "alias_id": {"type": "string"},
        "surface": {"$ref": "#/$defs/readingPair"},
        "alias_type": {"type": "string"},
        "label": {"$ref": "#/$defs/readingPair"},
        "resolution_mode": {"type": "string"},
        "semantic_status": {"enum": ["exact", "contextual", "ambiguous"]},
        "semantic_label": {"$ref": "#/$defs/readingPair"},
        "status": {"type": "string"},
        "observed_in_shishuo": {
          "type": "object",
          "required": ["main_text", "liu_annotation"],
          "properties": {"main_text": {"type": "boolean"}, "liu_annotation": {"type": "boolean"}}
        },
        "source_layers": {"type": "array", "items": {"enum": ["main_text", "liu_annotation"]}},
        "occurrence_count": {"type": "integer", "minimum": 0},
        "mention_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "display_order": {"type": "integer", "minimum": 0}
      }
    },
    "personSketch": {
      "type": "object",
      "required": ["person_id", "scope_role", "review_status", "identity", "profile_evidence_ids", "aliases", "story_counts"],
      "properties": {
        "person_id": {"type": "string"},
        "scope_role": {"enum": ["primary", "supporting"]},
        "review_status": {"enum": ["candidate", "reviewed"]},
        "identity": {
          "type": "object",
          "required": ["canonical_name", "courtesy_name", "clan", "identity_roles", "brief_intro", "evidence_ids"],
          "properties": {
            "canonical_name": {"$ref": "#/$defs/readingPair"},
            "courtesy_name": {"anyOf": [{"$ref": "#/$defs/readingPair"}, {"type": "null"}]},
            "clan": {"anyOf": [{"$ref": "#/$defs/readingPair"}, {"type": "null"}]},
            "identity_roles": {"type": "array", "items": {"$ref": "#/$defs/readingPair"}},
            "brief_intro": {"anyOf": [{"$ref": "#/$defs/readingPair"}, {"type": "null"}]},
            "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
          }
        },
        "profile_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "aliases": {"type": "array", "items": {"$ref": "#/$defs/personSketchAlias"}},
        "story_counts": {
          "type": "object",
          "required": ["total", "main_text", "liu_annotation_only", "reader_ready"],
          "properties": {
            "total": {"type": "integer", "minimum": 0},
            "main_text": {"type": "integer", "minimum": 0},
            "liu_annotation_only": {"type": "integer", "minimum": 0},
            "reader_ready": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
