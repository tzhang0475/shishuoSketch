{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shishuo-sketch/schema/reading-source-qualification.schema.json",
  "title": "CRL1.1 reading source qualification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "stage", "records"],
  "properties": {
    "schema": {"const": 1},
    "stage": {"const": "crl1-1-reading-source-qualification"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "witness_id", "qualification", "uses",
        "allows_exact_transfer_analysis", "allows_trusted_reference_promotion",
        "allows_reader_ready_promotion", "source", "metadata", "documented_identity",
        "coverage", "limitations", "qualification_basis", "notes"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "witness_id": {"type": "string", "minLength": 1},
        "qualification": {"enum": ["qualified", "provisionally_qualified", "unqualified"]},
        "uses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "allows_exact_transfer_analysis": {"type": "boolean"},
        "allows_trusted_reference_promotion": {"type": "boolean"},
        "allows_reader_ready_promotion": {"type": "boolean"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "byte_size", "line_count_recorded", "encoding", "line_ending"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "byte_size": {"type": "integer", "minimum": 0},
            "line_count_recorded": {"type": "integer", "minimum": 0},
            "encoding": {"type": "string", "minLength": 1},
            "line_ending": {"type": "string", "minLength": 1}
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "registry_path", "registry_sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "registry_path": {"type": "string", "minLength": 1},
            "registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "documented_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["edition", "source_provider", "provenance_status", "text_authority", "structure_authority", "punctuation_present", "manual_edit_status"],
          "properties": {
            "edition": {"type": "string", "minLength": 1},
            "source_provider": {"type": "string", "minLength": 1},
            "provenance_status": {"type": "string", "minLength": 1},
            "text_authority": {"type": "string", "minLength": 1},
            "structure_authority": {"type": "string", "minLength": 1},
            "punctuation_present": {"type": "boolean"},
            "manual_edit_status": {"type": "string", "minLength": 1}
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canonical_entries", "numbered_reference_paragraphs", "missing_reference_entry_ids"],
          "properties": {
            "canonical_entries": {"type": "integer", "minimum": 0},
            "numbered_reference_paragraphs": {"type": "integer", "minimum": 0},
            "missing_reference_entry_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "qualification_basis": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "notes": {"type": "string", "minLength": 1}
      }
    }
  }
}
