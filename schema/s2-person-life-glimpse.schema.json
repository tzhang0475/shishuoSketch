{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shishuo-sketch/schema/s2-person-life-glimpse.schema.json",
  "title": "S2.2 Person life glimpse overlay",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "stage", "records"],
  "properties": {
    "schema": {"const": 1},
    "stage": {"const": "s2-person-life-glimpse"},
    "records": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["person_id", "points"],
        "properties": {
          "person_id": {"type": "string", "minLength": 1},
          "points": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "assertion_status", "review_status", "evidence_ids", "story_ids"],
              "properties": {
                "text": {"type": "string", "minLength": 1},
                "assertion_status": {"enum": ["attested", "reported", "inferred", "unknown"]},
                "review_status": {"enum": ["candidate", "reviewed"]},
                "evidence_ids": {"type": "array", "uniqueItems": true, "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "story_ids": {"type": "array", "uniqueItems": true, "minItems": 1, "items": {"type": "string", "minLength": 1}}
              }
            }
          }
        }
      }
    }
  }
}
