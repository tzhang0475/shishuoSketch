{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shishuo-sketch/schema/person-relation-review-r3b.schema.json",
  "title": "R3B reviewed Person Relation decisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "stage", "records"],
  "properties": {
    "schema": {"const": 1},
    "stage": {"const": "r3b-person-relation-review"},
    "records": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "string_list": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id", "person_a_id", "person_b_id", "decision",
        "canonical_relation_type", "canonical_relation_subtype", "relation_scope",
        "role_a", "role_b", "source_entry_ids", "source_unit_ids", "evidence_ids",
        "decision_note", "review_status"
      ],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^r3-candidate-[0-9a-f]{20}$"},
        "person_a_id": {"type": "string", "minLength": 1},
        "person_b_id": {"type": "string", "minLength": 1},
        "decision": {"enum": ["approved", "deferred", "rejected"]},
        "production_relation_id": {"type": "string", "pattern": "^relation-r3b-[0-9]{3}$"},
        "canonical_relation_type": {"type": "string", "minLength": 1},
        "canonical_relation_subtype": {"type": "string", "minLength": 1},
        "relation_scope": {"type": "string", "minLength": 1},
        "scope_event": {"type": ["string", "null"]},
        "label": {"type": "string", "minLength": 1},
        "role_a": {"type": "string", "minLength": 1},
        "role_b": {"type": "string", "minLength": 1},
        "source_entry_ids": {"$ref": "#/$defs/string_list"},
        "source_unit_ids": {"$ref": "#/$defs/string_list"},
        "evidence_ids": {"$ref": "#/$defs/string_list"},
        "decision_note": {"type": "string", "minLength": 1},
        "review_status": {"const": "reviewed"}
      },
      "allOf": [
        {
          "if": {"properties": {"decision": {"const": "approved"}}},
          "then": {"required": ["production_relation_id"]}
        }
      ]
    }
  }
}
