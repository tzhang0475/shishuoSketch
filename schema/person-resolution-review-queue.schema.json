{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shishuo-sketch/schema/person-resolution-review-queue.schema.json",
  "title": "ER1 Person Resolution Review Queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "stage", "generated_from", "counts", "records"],
  "properties": {
    "schema": {"const": 1},
    "stage": {"const": "er1-person-resolution-review-queue"},
    "generated_from": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "records": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": true,
        "required": ["review_id", "mention_id", "story_id", "section", "surface", "resolution_status", "candidates", "ambiguity_reasons", "review_status"],
        "properties": {
          "review_id": {"type": "string", "minLength": 1},
          "mention_id": {"type": "string", "minLength": 1},
          "story_id": {"type": "string", "minLength": 1},
          "section": {"enum": ["main_text", "liu_annotation"]},
          "surface": {"type": "string", "minLength": 1},
          "resolution_status": {"enum": ["resolved", "candidate_for_review", "unresolved"]},
          "candidates": {"type": "array"},
          "ambiguity_reasons": {"type": "array", "items": {"type": "string"}},
          "review_status": {"enum": ["candidate", "reviewed", "rejected", "todo"]}
        }
      }
    }
  }
}
