{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shishuosketch.local/schema/srm0-3b-semantic-delta.schema.json",
  "title": "SRM0.3B model contracts",
  "oneOf": [
    {
      "title": "Minimal reading gaps",
      "type": "object",
      "additionalProperties": false,
      "required": ["gaps"],
      "properties": {
        "gaps": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question_id", "story_span", "gap"],
            "properties": {
              "question_id": {"type": "string", "minLength": 1},
              "story_span": {"type": "string", "minLength": 1},
              "gap": {"type": "string", "minLength": 1, "maxLength": 120}
            }
          }
        }
      }
    },
    {
      "title": "Commentary semantic delta",
      "type": "object",
      "additionalProperties": false,
      "required": ["updates", "relation_candidates", "appraisal_candidates"],
      "properties": {
        "updates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question_id", "answered_aspects", "unanswered_aspects", "conflicts",
              "reading_sufficient", "historical_verification_open",
              "remaining_reading_gap", "refined_question"
            ],
            "properties": {
              "question_id": {"type": "string", "minLength": 1},
              "answered_aspects": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["claim", "evidence"],
                  "properties": {
                    "claim": {"type": "string", "minLength": 1},
                    "evidence": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["ref", "quote"],
                        "properties": {
                          "ref": {"type": "string", "minLength": 1},
                          "quote": {"type": "string", "minLength": 1}
                        }
                      }
                    }
                  }
                }
              },
              "unanswered_aspects": {"type": "array", "items": {"type": "string"}},
              "conflicts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["description", "evidence"],
                  "properties": {
                    "description": {"type": "string", "minLength": 1},
                    "evidence": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["ref", "quote"],
                        "properties": {
                          "ref": {"type": "string", "minLength": 1},
                          "quote": {"type": "string", "minLength": 1}
                        }
                      }
                    }
                  }
                }
              },
              "reading_sufficient": {"type": "boolean"},
              "historical_verification_open": {"type": "boolean"},
              "remaining_reading_gap": {"type": ["string", "null"]},
              "refined_question": {"type": ["string", "null"]}
            }
          }
        },
        "relation_candidates": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["persons", "observation", "evidence"],
            "properties": {
              "persons": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1}},
              "observation": {"type": "string", "minLength": 1},
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["ref", "quote"],
                  "properties": {
                    "ref": {"type": "string", "minLength": 1},
                    "quote": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        },
        "appraisal_candidates": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evaluator", "target", "appraisal_text", "evidence_ref", "evidence_quote"],
            "properties": {
              "evaluator": {"type": "string", "minLength": 1},
              "target": {"type": "string", "minLength": 1},
              "appraisal_text": {"type": "string", "minLength": 1},
              "evidence_ref": {"type": "string", "minLength": 1},
              "evidence_quote": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  ]
}
